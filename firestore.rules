rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===================== Helpers =====================
    function signedIn()  { return request.auth != null; }
    function myUid()     { return request.auth.uid; }
    function mePath()    { return /databases/$(database)/documents/users/$(myUid()); }
    function meExists()  { return signedIn() && exists(mePath()); }
    function me()        { return get(mePath()).data; }
    function iAmActive() { return meExists() && me().active == true; }
    function iAmAdmin()  { return iAmActive() && me().role == 'admin'; }
    // True jika user adalah Ortu AKTIF yang terhubung ke studentId ini
    // (relasi tersimpan di parent_links/{studentId}, doc id = studentId/NIS).
    function iAmOrtuOf(studentId) {
      return iAmActive()
        && me().role == 'ortu'
        && exists(/databases/$(database)/documents/parent_links/$(studentId))
        && get(/databases/$(database)/documents/parent_links/$(studentId)).data.parentUid == myUid();
    }
    // Bootstrap admin pertama: hanya mengizinkan pembuatan akun admin dengan
    // email hardcoded ini (dipakai `bootstrapAdmin` saat first-run).
    function isBootstrapAdmin(uid) {
      return request.resource.data.uid == uid
        && request.resource.data.role == 'admin'
        && request.resource.data.active == true
        && request.resource.data.email == 'admin@sekolahku.id';
    }

    // ===================== users =====================
    match /users/{uid} {
      // Registrasi mandiri: hanya boleh membuat dokumen DIRI SENDIRI.
      // Role dibatasi (admin & koperasi TIDAK bisa daftar sendiri), dan
      // akun baru selalu NONAKTIF sampai di-ACC admin.
      allow create: if signedIn()
        && request.auth.uid == uid
        && (
          // Registrasi mandiri: siswa/guru/ortu, selalu nonaktif.
          (request.resource.data.uid == uid
            && request.resource.data.role in ['siswa', 'guru', 'ortu']
            && request.resource.data.active == false)
          // Bootstrap admin pertama (email hardcoded, aktif).
          || isBootstrapAdmin(uid)
        );

      // Baca: dokumen sendiri, atau admin aktif.
      allow read: if signedIn()
        && (request.auth.uid == uid || iAmAdmin());

      // Update: admin aktif bebas mengubah apa saja. Pemilik akun boleh:
      // - mengubah 'name' / 'info' (profil)
      // - top-up saldo (bertambah, maks +500.000 per transaksi)
      // - bayar pakai saldo (berkurang, tidak boleh negatif)
      // CATATAN: wallet ini client-side — cukup untuk demo, TIDAK untuk uang
      // sungguhan. Produksi: pindahkan top-up ke admin/koperasi atau pakai
      // Cloud Function transaksi agar tidak bisa dipalsukan klien.
      allow update: if signedIn() && (
        iAmAdmin()
        || (
          request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'info'])
        )
        || (
          request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['saldo'])
          && request.resource.data.saldo > resource.data.saldo
          && request.resource.data.saldo - resource.data.saldo <= 500000
        )
        || (
          request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['saldo'])
          && request.resource.data.saldo < resource.data.saldo
          && request.resource.data.saldo >= 0
        )
      );

      allow delete: if iAmAdmin();
    }

    // ===================== parent_links (hubungan Ortu <-> Siswa) =====================
    // Doc id = studentId (NIS) supaya `iAmOrtuOf` bisa memverifikasi relasi
    // Ortu–Siswa lewat get() deterministik (bukan query).
    match /parent_links/{studentId} {
      // Ortu hanya boleh menautkan DIRINYA sendiri ke seorang siswa,
      // dan doc id harus sama dengan studentId yang ditulis.
      allow create: if signedIn()
        && request.resource.data.parentUid == myUid()
        && request.resource.data.studentId == studentId;
      // Baca: admin, atau Ortu pemilik link (dipakai query where parentUid == myUid).
      allow read: if signedIn()
        && (iAmAdmin() || resource.data.parentUid == myUid());
      allow update, delete: if iAmAdmin();
    }

    // ===================== akademik: students & grades =====================
    match /students/{studentId} {
      // Baca: admin, guru (butuh daftar/pilihan siswa), Ortu pemilik anak,
      // atau Siswa yang membaca datanya sendiri (via NIS).
      allow read: if signedIn() && iAmActive() && (
        iAmAdmin() || me().role == 'guru' || iAmOrtuOf(studentId)
        || (me().role == 'siswa' && me().nis == studentId)
      );
      // Tulis: hanya admin (termasuk seeding). Guru menginput nilai lewat `grades`.
      allow create, update, delete: if iAmAdmin();
    }

    match /grades/{gradeId} {
      // Baca: admin, guru, Ortu dari siswa yang nilainya dibaca, atau Siswa
      // yang membaca nilainya sendiri (via NIS).
      allow read: if signedIn() && iAmActive() && (
        iAmAdmin() || me().role == 'guru' || iAmOrtuOf(resource.data.studentId)
        || (me().role == 'siswa' && me().nis == resource.data.studentId)
      );
      // Buat: admin atau guru (guru menginput nilai siswa).
      allow create: if signedIn() && (iAmAdmin() || (iAmActive() && me().role == 'guru'));
      allow update, delete: if iAmAdmin();
    }

    // ===================== guru_relations (wali kelas & mapel) =====================
    match /guru_relations/{guruName} {
      // Dibaca guru & admin untuk menentukan siswa binaan. Diatur admin.
      allow read: if iAmAdmin() || (iAmActive() && me().role == 'guru');
      allow create, update, delete: if iAmAdmin();
    }

    // ===================== madings (Mading & Pengumuman) =====================
    match /madings/{id} {
      // Baca: semua pengguna aktif.
      allow read: if iAmActive();
      // Buat: admin bebas (langsung terbit); non-admin wajib 'Menunggu' & belum pin.
      allow create: if signedIn() && iAmActive() && (
        iAmAdmin() || (
          request.resource.data.status == 'Menunggu'
          && request.resource.data.pinned == false
        )
      );
      // Update/delete: hanya admin (ACC / tolak / semat / hapus).
      allow update, delete: if iAmAdmin();
    }

    // ===================== agendas (Kalender) =====================
    match /agendas/{id} {
      allow read: if iAmActive();
      allow create, update, delete: if iAmAdmin();
    }

    // ===================== notifications =====================
    match /notifications/{id} {
      // Dibaca & ditulis klien (difilter per-user di sisi aplikasi).
      allow read, create: if signedIn() && iAmActive();
      // Update hanya untuk menandai sudah dibaca (field readBy).
      allow update: if signedIn() && iAmActive()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']);
      allow delete: if iAmAdmin();
    }

    // ===================== koperasi: products & orders =====================
    match /products/{id} {
      allow read: if iAmActive();
      allow create, update, delete:
        if signedIn() && (iAmAdmin() || (iAmActive() && me().role == 'koperasi'));
    }

    match /orders/{id} {
      allow read: if iAmActive();
      allow create: if signedIn() && iAmActive();
      allow update: if signedIn() && (iAmAdmin() || (iAmActive() && me().role == 'koperasi'));
      allow delete: if iAmAdmin();
    }

    // ===================== pengaduan: complaints =====================
    match /complaints/{id} {
      allow read: if iAmActive();
      allow create: if signedIn() && iAmActive();
      allow update, delete: if iAmAdmin();
    }

    // ===================== moderasi: reports =====================
    match /reports/{id} {
      // Admin membaca & memproses laporan konten; user aktif bisa melaporkan.
      allow read: if iAmAdmin();
      allow create: if signedIn() && iAmActive();
      allow update, delete: if iAmAdmin();
    }

    // ===================== lost & found: lf_items & lf_claims =====================
    match /lf_items/{id} {
      allow read: if iAmActive();
      allow create: if signedIn() && iAmActive();
      allow update, delete: if iAmAdmin();
    }

    match /lf_claims/{id} {
      allow read: if iAmActive();
      allow create: if signedIn() && iAmActive();
      allow update, delete: if iAmAdmin();
    }

    // ===================== booking & aduan =====================
    match /bookings/{id} {
      allow read: if iAmActive();
      allow create: if signedIn() && iAmActive();
      allow update, delete: if iAmAdmin();
    }

    match /aduans/{id} {
      allow read: if iAmActive();
      allow create: if signedIn() && iAmActive();
      allow update, delete: if iAmAdmin();
    }

    // ===================== Catatan =====================
    // `students`, `grades`, & `parent_links` sudah ter-cover di atas.
    // UI akademik (Ortu/Guru) masih membaca RelationsService in-memory;
    // migrasi view ke Firebase dilakukan terpisah. Apa pun yang tidak
    // tercantum = DENY (aman).
  }
}