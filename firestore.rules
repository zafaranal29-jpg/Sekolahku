rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===================== Helpers =====================
    function signedIn()  { return request.auth != null; }
    function myUid()     { return request.auth.uid; }
    function mePath()    { return /databases/$(database)/documents/users/$(myUid()); }
    function meExists()  { return signedIn() && exists(mePath()); }
    function me()        { return get(mePath()).data; }
    function iAmActive() { return meExists() && me().active == true; }
    function iAmAdmin()  { return iAmActive() && me().role == 'admin'; }
    // True jika user adalah Ortu AKTIF yang terhubung ke studentId ini
    // (relasi tersimpan di parent_links/{studentId}, doc id = studentId/NIS).
    function iAmOrtuOf(studentId) {
      return iAmActive()
        && me().role == 'ortu'
        && exists(/databases/$(database)/documents/parent_links/$(studentId))
        && get(/databases/$(database)/documents/parent_links/$(studentId)).data.parentUid == myUid();
    }

    // ---- Helper akademik (revisi Wali Kelas) ----
    function iAmGuru()   { return iAmActive() && me().role == 'guru'; }
    function iAmWali()   { return iAmActive() && me().role == 'waliKelas'; }
    // Wali kelas AKTIF yang kelas binaannya (users/{uid}.waliKelas) == kelas.
    function iAmWaliOf(kelas) { return iAmWali() && me().get('waliKelas', '') == kelas; }
    function iAmStaff()  { return iAmAdmin() || iAmGuru() || iAmWali(); }
    // Siswa AKTIF yang NIS-nya (users/{uid}.nis) == nis.
    function iAmSiswa(nis) { return iAmActive() && me().role == 'siswa' && me().get('nis', '') == nis; }
    function studentPath(nis) { return /databases/$(database)/documents/students/$(nis); }
    // True jika students/{nis} ada dan kelasnya == kelas (mencegah menulis
    // nilai/absensi dengan kelas palsu).
    function studentInKelas(nis, kelas) {
      return exists(studentPath(nis)) && get(studentPath(nis)).data.kelas == kelas;
    }
    // Siswa / ortu yang boleh melihat data kelas tertentu (untuk jadwal).
    function iAmSiswaOfKelas(kelas) {
      return iAmActive() && me().role == 'siswa' && me().get('kelas', '') == kelas;
    }
    function iAmOrtuOfKelas(kelas) {
      return iAmActive() && me().role == 'ortu'
        && iAmOrtuOf(me().get('nisAnak', '-'))
        && studentInKelas(me().get('nisAnak', '-'), kelas);
    }

    // ===================== users =====================
    match /users/{uid} {
      // Registrasi mandiri: hanya boleh membuat dokumen DIRI SENDIRI.
      // Role dibatasi (ADMIN tidak bisa daftar sendiri; koperasi & waliKelas
      // boleh mendaftar tetapi tetap NONAKTIF sampai diverifikasi admin),
      // saldo awal 0, dan tidak boleh langsung menetapkan diri ketua ekskul.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role in ['siswa', 'guru', 'ortu', 'koperasi', 'waliKelas']
        && request.resource.data.active == false
        && request.resource.data.get('saldo', 0) == 0
        && !('ketuaOf' in request.resource.data);

      // Baca: dokumen sendiri, atau admin aktif.
      allow read: if signedIn()
        && (request.auth.uid == uid || iAmAdmin());

      // Update: admin aktif bebas mengubah apa saja. Pemilik akun hanya
      // boleh mengubah 'name' / 'info' (tidak boleh active / role / ketuaOf /
      // uid / nis / kelas / waliKelas / nisAnak) -> role tidak bisa dinaikkan sendiri.
      allow update: if signedIn() && (
        iAmAdmin()
        || (
          request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'info'])
        )
      );

      allow delete: if iAmAdmin();
    }

    // ===================== parent_links (hubungan Ortu <-> Siswa) =====================
    // Doc id = studentId (NIS) supaya `iAmOrtuOf` bisa memverifikasi relasi
    // Ortu–Siswa lewat get() deterministik (bukan query).
    match /parent_links/{studentId} {
      // Ortu hanya boleh menautkan DIRINYA sendiri ke seorang siswa,
      // dan doc id harus sama dengan studentId yang ditulis.
      allow create: if signedIn()
        && request.resource.data.parentUid == myUid()
        && request.resource.data.studentId == studentId;
      // Baca: admin, atau Ortu pemilik link (dipakai query where parentUid == myUid).
      allow read: if signedIn()
        && (iAmAdmin() || resource.data.parentUid == myUid());
      allow update, delete: if iAmAdmin();
    }

    // ===================== madings (Mading & Pengumuman) =====================
    match /madings/{id} {
      // Baca: semua pengguna aktif.
      allow read: if iAmActive();
      // Buat: admin bebas (langsung terbit); non-admin wajib 'Menunggu' & belum pin.
      allow create: if signedIn() && iAmActive() && (
        iAmAdmin() || (
          request.resource.data.status == 'Menunggu'
          && request.resource.data.pinned == false
        )
      );
      // Update/delete: hanya admin (ACC / tolak / semat / hapus).
      allow update, delete: if iAmAdmin();
    }

    // ===================== agendas (Kalender) =====================
    match /agendas/{id} {
      allow read: if iAmActive();
      allow create, update, delete: if iAmAdmin();
    }

    // ===================== notifications =====================
    match /notifications/{id} {
      // Dibaca & ditulis klien (difilter per-user di sisi aplikasi).
      allow read, create: if signedIn() && iAmActive();
      // Update hanya untuk menandai sudah dibaca (field readBy).
      allow update: if signedIn() && iAmActive()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']);
      allow delete: if iAmAdmin();
    }

    // ===================== koperasi: products & orders =====================
    match /products/{id} {
      allow read: if iAmActive();
      allow create, update, delete:
        if signedIn() && (iAmAdmin() || (iAmActive() && me().role == 'koperasi'));
    }

    match /orders/{id} {
      allow read: if iAmActive();
      allow create: if signedIn() && iAmActive();
      allow update: if signedIn() && (iAmAdmin() || (iAmActive() && me().role == 'koperasi'));
      allow delete: if iAmAdmin();
    }

    // ===================== pengaduan: complaints =====================
    match /complaints/{id} {
      allow read: if iAmActive();
      allow create: if signedIn() && iAmActive();
      allow update, delete: if iAmAdmin();
    }

    // ===================== lost & found: lf_items & lf_claims =====================
    match /lf_items/{id} {
      allow read: if iAmActive();
      allow create: if signedIn() && iAmActive();
      allow update, delete: if iAmAdmin();
    }

    match /lf_claims/{id} {
      allow read: if iAmActive();
      allow create: if signedIn() && iAmActive();
      allow update, delete: if iAmAdmin();
    }

    // ===================== booking & aduan =====================
    match /bookings/{id} {
      allow read: if iAmActive();
      allow create: if signedIn() && iAmActive();
      allow update, delete: if iAmAdmin();
    }

    match /aduans/{id} {
      allow read: if iAmActive();
      allow create: if signedIn() && iAmActive();
      allow update, delete: if iAmAdmin();
    }

    // ===================== students (data master siswa) =====================
    // Doc id = NIS. Ditulis admin (otomatis saat mengaktifkan siswa / mengatur
    // NIS & kelas). Dibaca guru/wali kelas/admin, siswa itu sendiri, dan ortunya.
    match /students/{nis} {
      allow read: if iAmStaff() || iAmSiswa(nis) || iAmOrtuOf(nis);
      allow write: if iAmAdmin();
    }

    // ===================== nilai (guru input -> wali kelas konfirmasi) =====================
    match /nilai/{id} {
      // Baca:
      // - admin
      // - guru: nilai yang ia input sendiri (pantau status) + semua yang Terkonfirmasi
      // - wali kelas: semua nilai di kelas binaannya (untuk dikonfirmasi)
      // - siswa & ortu: HANYA nilai Terkonfirmasi milik siswa/anak tsb
      allow read: if iAmAdmin()
        || (iAmGuru() && resource.data.guruUid == myUid())
        || ((iAmGuru() || iAmWali()) && resource.data.status == 'Terkonfirmasi')
        || iAmWaliOf(resource.data.kelas)
        || (resource.data.status == 'Terkonfirmasi'
            && (iAmSiswa(resource.data.nis) || iAmOrtuOf(resource.data.nis)));

      // Buat: guru aktif, atas namanya sendiri, status WAJIB menunggu,
      // nilai 0-100, dan kelas harus sama dengan kelas siswa di students/{nis}.
      allow create: if (iAmGuru() || iAmAdmin())
        && request.resource.data.keys().hasOnly(['nis', 'studentName', 'kelas', 'mapel', 'jenis',
             'semester', 'nilai', 'catatan', 'guruUid', 'guruName', 'status', 'createdAt'])
        && request.resource.data.guruUid == myUid()
        && request.resource.data.status == 'Menunggu konfirmasi'
        && request.resource.data.nilai is number
        && request.resource.data.nilai >= 0
        && request.resource.data.nilai <= 100
        && request.resource.data.mapel is string
        && request.resource.data.mapel.size() > 0
        && studentInKelas(request.resource.data.nis, request.resource.data.kelas);

      // Ubah status: hanya wali kelas dari kelas nilai tsb selama nilai masih
      // menunggu (admin boleh mengoreksi kapan saja). Yang boleh berubah hanya
      // field konfirmasi; angka nilai tidak bisa diubah.
      allow update: if (iAmAdmin()
                        || (iAmWaliOf(resource.data.kelas)
                            && resource.data.status == 'Menunggu konfirmasi'))
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'alasanTolak', 'confirmedBy', 'confirmedAt'])
        && request.resource.data.status in ['Terkonfirmasi', 'Ditolak'];

      // Hapus: admin, atau guru pemilik selama belum terkonfirmasi.
      allow delete: if iAmAdmin()
        || (iAmGuru() && resource.data.guruUid == myUid()
            && resource.data.status != 'Terkonfirmasi');
    }

    // ===================== jadwal (jadwal pelajaran per kelas) =====================
    match /jadwal/{id} {
      allow read: if iAmStaff()
        || iAmSiswaOfKelas(resource.data.kelas)
        || iAmOrtuOfKelas(resource.data.kelas);
      allow create: if (iAmWaliOf(request.resource.data.kelas) || iAmAdmin())
        && request.resource.data.hari in ['Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu']
        && request.resource.data.mapel is string
        && request.resource.data.jamMulai is string
        && request.resource.data.jamSelesai is string;
      // Update: tidak boleh memindahkan jadwal ke / dari kelas lain.
      allow update: if (iAmAdmin() || (iAmWaliOf(resource.data.kelas)
                                        && request.resource.data.kelas == resource.data.kelas))
        && request.resource.data.hari in ['Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu'];
      allow delete: if iAmWaliOf(resource.data.kelas) || iAmAdmin();
    }

    // ===================== absensi (doc id = {nis}_{yyyy-MM-dd}) =====================
    match /absensi/{absenId} {
      allow read: if iAmAdmin()
        || iAmWaliOf(resource.data.kelas)
        || iAmSiswa(resource.data.nis)
        || iAmOrtuOf(resource.data.nis);
      // Tulis (create/update lewat set()): wali kelas dari kelas siswa tsb, atau admin.
      allow create, update: if (iAmWaliOf(request.resource.data.kelas) || iAmAdmin())
        && absenId == request.resource.data.nis + '_' + request.resource.data.tanggal
        && request.resource.data.status in ['Hadir', 'Sakit', 'Izin', 'Alpa']
        && studentInKelas(request.resource.data.nis, request.resource.data.kelas)
        && (resource == null || resource.data.kelas == request.resource.data.kelas || iAmAdmin());
      allow delete: if iAmWaliOf(resource.data.kelas) || iAmAdmin();
    }

    // ===================== Belum dimigrasi =====================
    // Koleksi lama `grades` tidak dipakai lagi (diganti `nilai`). Apa pun
    // yang tidak tercantum = DENY (aman).
  }
}